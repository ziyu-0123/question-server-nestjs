# MongoDB 连接配置
# 部署云库（如 MongoDB Atlas）时，配置 MONGO_URI 即可（优先于下面三个变量）
# MONGO_URI=mongodb+srv://user:pass@cluster0.xxx.mongodb.net/nestdb
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DATABASE=nestdb

# JWT 签名密钥（生产环境请替换为随机长字符串）
JWT_SECRET=xxYx&&111

# CORS 白名单（逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
